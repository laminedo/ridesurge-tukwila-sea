# Base URL of the TimesFM sidecar (see services/timesfm/server.py).
# Leave unset to use the built-in emulator.
# TIMESFM_URL=http://127.0.0.1:8765

# Police radar reports database (Supabase). Defaults to the project in src/lib/police.ts.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_KEY=sb_publishable_...
